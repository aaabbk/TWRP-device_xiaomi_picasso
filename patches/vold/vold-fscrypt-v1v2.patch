+// Android 14+ stores the synthetic password state files under a per-protector random id
+// ("<protector id>.spblob/.pwd/.secdis") instead of the single legacy keystore "sp-handle".
+// Older ROMs keep using the legacy handle.  Resolve which id this user's state files use:
+// prefer the legacy handle when its files exist, otherwise scan the spblob directory.
+// Cached result of the last successful resolution: TWRP unmounts and remounts /data while
+// decrypting, so a later lookup can transiently fail even though we already know the id.
+static std::string s_cached_spblob_id;
+
+// Make sure the DE keys are installed and /data/system_de is readable again.  TWRP calls into
+// decryption more than once and may have unmounted /data in between.
+static bool Is_Data_Mounted() {
+    FILE* f = fopen("/proc/mounts", "r");
+    if (f == NULL) return false;
+    char line[512];
+    bool mounted = false;
+    while (fgets(line, sizeof(line), f) != NULL) {
+        if (strstr(line, " /data ") != NULL) {
+            mounted = true;
+            break;
+        }
+    }
+    fclose(f);
+    return mounted;
+}
+
+static void Ensure_Data_Accessible() {
+    if (access("/data/system_de/0", F_OK) == 0) return;
+    printf("twrp_spblob: /data/system_de/0 not accessible (data mounted=%d), re-initializing\n",
+           (int)Is_Data_Mounted());
+    if (!Decrypt_DE()) {
+        printf("twrp_spblob: DE re-initialization failed\n");
+        return;
+    }
+    printf("twrp_spblob: DE access %s after retry (data mounted=%d)\n",
+           access("/data/system_de/0", F_OK) == 0 ? "recovered" : "still broken",
+           (int)Is_Data_Mounted());
+}
+
+static std::string Resolve_Spblob_Id(const std::string& spblob_path,
+                                     const std::string& legacy_handle) {
+    printf("twrp_spblob: spblob_path=%s legacy_handle='%s' cached='%s'\n", spblob_path.c_str(),
+           legacy_handle.c_str(), s_cached_spblob_id.c_str());
+    Ensure_Data_Accessible();
+
+    if (!legacy_handle.empty() &&
+        android::vold::pathExists(spblob_path + legacy_handle + ".spblob")) {
+        printf("twrp_spblob: using legacy handle %s\n", legacy_handle.c_str());
+        s_cached_spblob_id = legacy_handle;
+        return legacy_handle;
+    }
+
+    std::map<std::string, bool> has_pwd;
+    std::map<std::string, bool> has_spblob;
+    DIR* dir = opendir(spblob_path.c_str());
+    if (dir == NULL) {
+        printf("twrp_spblob: cannot open %s: %s\n", spblob_path.c_str(), strerror(errno));
+        if (!s_cached_spblob_id.empty()) {
+            printf("twrp_spblob: using cached id %s instead\n", s_cached_spblob_id.c_str());
+            return s_cached_spblob_id;
+        }
+        return legacy_handle;
+    }
+    struct dirent* entry;
+    while ((entry = readdir(dir)) != NULL) {
+        std::string name = entry->d_name;
+        if (name == "." || name == "..") continue;
+        printf("twrp_spblob: entry %s\n", name.c_str());
+        if (name.size() > 4 && name.compare(name.size() - 4, 4, ".pwd") == 0) {
+            has_pwd[name.substr(0, name.size() - 4)] = true;
+        } else if (name.size() > 7 && name.compare(name.size() - 7, 7, ".spblob") == 0) {
+            has_spblob[name.substr(0, name.size() - 7)] = true;
+        }
+    }
+    closedir(dir);
+
+    // An LSKF based protector has both .pwd and .spblob; prefer it over other protectors.
+    for (auto& item : has_pwd) {
+        if (has_spblob.count(item.first)) {
+            printf("twrp_spblob: using protector id %s (has .pwd and .spblob)\n",
+                   item.first.c_str());
+            s_cached_spblob_id = item.first;
+            return item.first;
+        }
+    }
+    if (!has_spblob.empty()) {
+        const std::string& only_spblob_id = has_spblob.begin()->first;
+        printf("twrp_spblob: using protector id %s (only .spblob)\n", only_spblob_id.c_str());
+        s_cached_spblob_id = only_spblob_id;
+        return only_spblob_id;
+    }
+    if (!s_cached_spblob_id.empty()) {
+        printf("twrp_spblob: falling back to cached id %s\n", s_cached_spblob_id.c_str());
+        return s_cached_spblob_id;
+    }
+    printf("twrp_spblob: no usable state file found, falling back to legacy handle\n");
+    return legacy_handle;
+}
