+// Installs the key using the fscrypt policy version actually in use on this device.  When the
+// install fails (e.g. the on-disk policy could not be probed, or it changed since the fstab was
+// written) the other policy version is tried as a fallback.
+bool installKey(const std::string& mountpoint, const EncryptionOptions& options,
+                const KeyBuffer& key, EncryptionPolicy* policy) {
+    EncryptionOptions opts = options;
+
+    printf("twrp_install_key: mountpoint=%s fstab_version=%d wrapped=%d\n", mountpoint.c_str(),
+           opts.version, (int)opts.use_hw_wrapped_key);
+
+    // The fscrypt policy version in the fstab only describes what a freshly formatted data
+    // partition would use.  Data formatted by an older or newer ROM keeps the version it was
+    // created with, so trust the on-disk policy whenever it can be determined.
+    int detected = DetectDataPolicyVersion();
+    if (detected != 0 && detected != opts.version) {
+        printf("twrp_install_key: detected policy v%d, overriding fstab v%d\n", detected,
+               opts.version);
+        opts.version = detected;
+    }
+
+    if (installKeyOnce(mountpoint, opts, key, policy)) return true;
+
+    // The on-disk policy is authoritative, so a failure with a detected version must be
+    // reported instead of silently installing the key for the other policy version, which
+    // would only mask the real problem.  Only fall back to the other version when the
+    // version could not be probed and we were merely guessing from the fstab.
+    if (detected != 0) {
+        printf("twrp_install_key: install v%d failed, detection was explicit, not retrying\n",
+               opts.version);
+        return false;
+    }
+
+    EncryptionOptions alternate = opts;
+    alternate.version = (opts.version == 1) ? 2 : 1;
+    printf("twrp_install_key: install v%d failed, retrying v%d\n", opts.version,
+           alternate.version);
+    return installKeyOnce(mountpoint, alternate, key, policy);
+}
